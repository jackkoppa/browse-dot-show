{
  "name": "browse-dot-show",
  "version": "0.0.1",
  "private": true,
  "description": "transcribe & search any podcast",
  "scripts": {
    "bds": "NODE_OPTIONS=--max-old-space-size=9728 tsx scripts/cli/index.ts",
    "all:build": "pnpm --filter @browse-dot-show/* build",
    "all:build:prod": "pnpm --filter @browse-dot-show/* build:prod",
    "all:test": "pnpm --filter @browse-dot-show/* test",
    "all:lint": "oxlint",
    "all:typecheck": "tsx scripts/ci/typecheck.ts",
    "validate:sites": "pnpm --filter @browse-dot-show/sites validate",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.15.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.45.1",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxlint": "^1.3.0",
    "tsx": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "oxlint",
    "scripts/**/*.ts": "bash -c 'pnpm --filter @browse-dot-show/scripts typecheck'",
    "packages/ingestion/process-audio-lambda/**/*.ts": "bash -c 'pnpm --filter @browse-dot-show/process-audio-lambda typecheck'"
  },
  "packageManager": "pnpm@10.15.1"
}
